{
  "name": "zcord",
  "productName": "zcord",
  "version": "1.1.0",
  "description": "Screen recorder for teachers: reliable full-screen capture, on-screen drawing, and automatic upload to a Google Drive class-recordings folder.",
  "main": "src/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "app.zcord.recorder",
    "productName": "zcord",
    "files": [
      "src/**/*",
      "package.json",
      "zcord.config.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "zcord-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.education",
      "identity": null,
      "artifactName": "zcord-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "zcord records your voice while you teach.",
        "NSCameraUsageDescription": "zcord does not use the camera, but macOS may ask on its behalf."
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Education",
      "artifactName": "zcord-${version}.${ext}"
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "zcord",
      "runAfterFinish": true
    },
    "dmg": {
      "title": "zcord ${version}"
    }
  },
  "author": "Ziyan Nifail",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZiyanNifail/zcord.git"
  }
}
